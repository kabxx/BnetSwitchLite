{
  "name": "bnetswitchlite",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first Battle.net account switcher: save once, switch cleanly on Windows and macOS.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:macos:arm64": "tauri build --target aarch64-apple-darwin --bundles app --ci",
    "bundle:macos:x64": "tauri build --target x86_64-apple-darwin --bundles app --ci",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:macos": "sh scripts/package-macos-app.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
